NODE_ENV="string"

# banco externo - usado em production
DATABASE_URL="string"

# banco em container - usado em development
MSSQL_DB="string"
MSSQL_SA_PASSWORD="string"
MSSQL_PORT="string"

# app config
APP_ENV="string"
APP_PORT="string"
APP_VERSION="string"

# cors configuration
CORS_ORIGIN="string"
CORS_METHODS="string"
CORS_PREFLIGHT="string"
CORS_SUSS_STATUS="string"

# swagger configuration
SWAGGER_TITLE="string"
SWAGGER_DESCRIPTION="string"
SWAGGER_VERSION="string"
SWAGGER_ENDPOINT="string"
SWAGGER_API_URL="string"
SWAGGER_ENABLED="string"

# jwt configuration
JWT_AT_SECRET="string"
JWT_AT_EXPIRES="string"
JWT_RT_SECRET="string"
JWT_RT_EXPIRES="string"

# sso do portal adata
# url base da api do portal (sem /api); no sandbox local: http://localhost:3010
SSO_PORTAL_API_URL="string"
# chave enviada no header x-api-key da troca do codigo; fornecida pelo portal
SSO_API_KEY="string"
# id do tmdb no cadastro de sistemas do portal
SSO_SYSTEM_ID="string"
# origem publica do front do tmdb, igual ao sso_origin cadastrado no portal (sem barra final)
SSO_FRONTEND_ORIGIN="string"

# Nodemailer
MAIL_HOST="string"
MAIL_PORT="string"
MAIL_FROM="string"

# marque como true caso não esteja usando relay
MAIL_REQUIRED_AUTH="string"
MAIL_AUTH_USER="string"
MAIL_AUTH_PASS="string"

# parametros de configuracao do email
MAIL_SECURE="string"
MAIL_TLS_ENABLE="string"

# minio
MINIO_ENDPOINT="string"
MINIO_PORT="string"
MINIO_USE_SSL="string"
MINIO_ACCESS_KEY="string"
MINIO_SECRET_KEY="string"
MINIO_BUCKET="string"
MINIO_API_URL="string"

# integracoes externas
# ENABLE_MES=true consulta a API do MES; false usa a lista local de exemplo
ENABLE_MES="string"
MES_API_URL="string"
MES_API_USER="string"
MES_API_PASSWORD="string"
DATA_COLLECTION_API_URL="string"
DATA_COLLECTION_BFF_API_URL="string"
DATA_COLLECTION_API_USER="string"
DATA_COLLECTION_API_PASSWORD="string"

# importacao de rotinas do RMS na sincronizacao de maquinas
ENABLE_RMS_IMPORT="string"
RMS_API_URL="string"
RMS_API_USER="string"
RMS_API_PASSWORD="string"
