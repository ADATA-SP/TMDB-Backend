generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model users {
  id               Int                @id @default(autoincrement())
  name             String             @db.Text
  username         String?            @unique(map: "USERS_username_IDX") @db.VarChar(100)
  email            String?            @unique(map: "USERS_email_IDX") @db.VarChar(100)
  password         String?            @db.VarChar(255)
  status           Int                @default(1) @db.TinyInt
  path_image       String?            @db.VarChar(255)
  created_at       DateTime?          @default(now()) @db.DateTime
  updated_at       DateTime?          @default(now()) @db.DateTime
  ldap_crendential Int?               @default(0) @db.TinyInt
  profile_id       Int?
  profiles         profiles?          @relation(fields: [profile_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "users_profiles_FK")
  audit_log        audit_log[]
  notification_log notification_log[]

  @@map("users")
}

model profiles {
  id                Int                 @id @default(autoincrement())
  description       String              @db.VarChar(30)
  identifier        String              @unique(map: "profiles_identifier_IDX") @db.VarChar(80)
  external          Int                 @default(1) @db.TinyInt
  status            Int                 @default(1) @db.TinyInt
  created_at        DateTime?           @default(now()) @db.DateTime
  updated_at        DateTime?           @default(now()) @db.DateTime
  profile_operation profile_operation[]
  users             users[]

  @@map("profiles")
}

model modules {
  id          Int          @id @default(autoincrement())
  description String       @db.VarChar(150)
  slug        String       @unique(map: "modules_identifier_IDX") @db.VarChar(100)
  status      Int          @default(1) @db.TinyInt
  created_at  DateTime?    @default(now()) @db.DateTime
  updated_at  DateTime?    @default(now()) @db.DateTime
  operations  operations[]

  @@map("modules")
}

model operations {
  id                Int                 @id @default(autoincrement())
  description       String              @db.VarChar(100)
  identifier        String              @unique(map: "operations_identifier_IDX") @db.VarChar(100)
  status            Int                 @default(1) @db.TinyInt
  module_id         Int
  modules           modules             @relation(fields: [module_id], references: [id], onUpdate: NoAction, map: "operations_modules_FK")
  profile_operation profile_operation[]

  @@map("operations")
}

model profile_operation {
  profile_id   Int
  operation_id Int
  operations   operations @relation(fields: [operation_id], references: [id], onUpdate: NoAction, map: "fk_profile_has_operation_operation")
  profiles     profiles   @relation(fields: [profile_id], references: [id], onUpdate: NoAction, map: "fk_profile_has_operation_profile")

  @@id([operation_id, profile_id])
  @@index([operation_id], map: "profile_operation_operation_id_IDX")
  @@index([profile_id], map: "profile_operation_profile_id_IDX")
  @@map("profile_operation")
}

model machines {
  id           Int       @id @default(autoincrement())
  description  String    @db.VarChar(100)
  code         String    @db.VarChar(45)
  ip_address   String?   @db.VarChar(45)
  port_address String?   @db.VarChar(45)
  status       Int       @default(1) @db.TinyInt
  created_at   DateTime? @default(now()) @db.DateTime
  updated_at   DateTime? @default(now()) @db.DateTime
  machine_type String    @db.VarChar(100)
  localization String    @db.VarChar(100)
  is_blocked   Int       @default(0) @db.TinyInt
  routes       routes[]

  @@map("machines")
}

model routes {
  id          Int       @id @default(autoincrement())
  description String    @db.VarChar(55)
  status      Int       @default(1) @db.TinyInt
  created_at  DateTime? @default(now()) @db.DateTime
  updated_at  DateTime? @default(now()) @db.DateTime
  machine_id  Int?
  machines    machines? @relation(fields: [machine_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "routes_machines_FK")

  @@map("routes")
}

model routines {
  id                       Int              @id @default(autoincrement())
  type                     String           @default("RUN")
  created_at               DateTime?        @default(now()) @db.DateTime
  updated_at               DateTime?        @default(now()) @db.DateTime
  machine_id               Int
  delay_execution          Int              @default(5) @db.TinyInt
  description              String?          @db.VarChar(170)
  validate_recipe_success  Int              @default(1) @db.TinyInt
  ignore_recipe_validation Int?             @db.TinyInt
  routine_action           routine_action[]
  reason_code              reason_code[]

  @@map("routines")
}

model actions {
  id             Int              @id @default(autoincrement())
  description    String?          @db.VarChar(105)
  command        String           @db.Text
  created_at     DateTime?        @default(now()) @db.DateTime
  updated_at     DateTime?        @default(now()) @db.DateTime
  name           String?          @db.VarChar(80)
  machine_type   String?          @db.VarChar(100)
  routine_action routine_action[]

  @@map("actions")
}

model routine_action {
  routine_id Int
  action_id  Int
  position   Int       @db.TinyInt
  created_at DateTime? @default(now()) @db.DateTime
  updated_at DateTime? @default(now()) @db.DateTime
  actions    actions   @relation(fields: [action_id], references: [id], onUpdate: NoAction, map: "routine_action_actions_FK")
  routines   routines  @relation(fields: [routine_id], references: [id], onUpdate: NoAction, map: "routine_action_routines_FK")

  @@id([routine_id, action_id], map: "routine_action_pk")
  @@map("routine_action")
}

model reason_code {
  id         Int       @id @default(autoincrement())
  code       String    @db.NVarChar(20)
  ignored    Int       @default(1)
  created_at DateTime? @default(now()) @db.DateTime
  updated_at DateTime? @default(now()) @db.DateTime
  routine_id Int
  routines   routines? @relation(fields: [routine_id], references: [id], map: "reason_code_routines_FK")

  @@unique([code, routine_id])
  @@map("reason_code")
}

model audit_log {
  id          Int       @id @default(autoincrement())
  type        String?   @db.VarChar(50)
  description String?   @db.VarChar(100)
  operation   String?   @db.VarChar(50)
  user_id     Int?
  created_at  DateTime? @default(now()) @db.DateTime
  updated_at  DateTime? @default(now()) @db.DateTime
  users       users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "audit_log_users_FK")

  @@map("audit_log")
}

model notification_log {
  id           Int       @id @default(autoincrement())
  type         String?   @db.VarChar(50)
  description  String?   @db.VarChar(100)
  created_at   DateTime? @default(now()) @db.DateTime
  updated_at   DateTime? @default(now()) @db.DateTime
  machine_code String?   @db.VarChar(20)
  user_id      Int?
  users        users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "notification_log_users_FK")

  @@map("notification_log")
}
